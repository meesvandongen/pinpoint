{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinpoint",
  "compatibility_date": "2026-10-22",
  // Static output of `pnpm run build`, including the game content under /content.
  // Workers Builds runs the build, then deploys or previews; CI never runs Wrangler.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true,
  "previews": {}
}
